# =============================================================================
# Adi assistant backend - configuration reference
# Copy to .env and fill in what you use. NEVER commit .env or real secrets.
# Everything below works in mock mode with no API keys.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Empty = local SQLite file (./assistant.db). PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://adi:change-me@localhost:5432/adi
DATABASE_URL=

# Optional: if set, /api/v1/chat, /voice, /spotify/* controls and /device/clients
# require the header "X-API-Key: <value>". Also used as the device token if no
# DEVICE_* token is set. Leave empty only for local development.
API_KEY=

# Maximum accepted audio upload size in bytes (default ~5 MB).
MAX_AUDIO_BYTES=5000000

# --- Providers ---------------------------------------------------------------
# "mock" (offline, free) or "gemini". Mixing is allowed.
STT_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock

# --- Assistant identity & behaviour ------------------------------------------
ASSISTANT_NAME=Adi
WAKE_WORD=Alexa
# strip   = remove a leading wake word, process everything (device detects wake word)
# require = ignore speech that doesn't start with the wake word (always-listening devices)
# off     = no wake-word handling
WAKE_WORD_MODE=strip
# Other spellings STT may produce, comma-separated, e.g. Aadi,Addy
WAKE_WORD_ALIASES=Alexia,Alexsa,Alex
# Spoken when only the wake word is heard; the device should then keep listening.
WAKE_ACK_TEXT=Yes?
# IANA timezone for time/date answers, e.g. Asia/Kolkata. Empty = server local time.
ASSISTANT_TIMEZONE=
# Short-term memory for follow-ups ("pause it"). 0 disables.
CONVERSATION_MAX_TURNS=6
CONVERSATION_TTL_SECONDS=900
# Session used when a client sends no session ID. Empty = stateless requests.
CONVERSATION_DEFAULT_SESSION=default
# Answer exact short commands ("pause", "what time is it") without calling the LLM.
FAST_INTENTS_ENABLED=true
# Speak a tool's own confirmation ("Paused.") instead of making a second LLM call.
TOOL_DIRECT_REPLIES=true

# --- Google Gemini (needed when any *_PROVIDER is gemini) --------------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Prebuilt voice (Kore, Puck, Charon, Achird, ...) or a custom voice_... ID.
GEMINI_TTS_VOICE=Kore
# Thinking tokens count against this cap - don't set it very low.
GEMINI_LLM_MAX_OUTPUT_TOKENS=1024
# Empty = model default (recommended).
GEMINI_LLM_TEMPERATURE=
# Empty = model default. minimal | low | medium | high (support varies by model).
GEMINI_LLM_THINKING_LEVEL=
# Comma-separated BCP-47 hints, e.g. en-IN,hi-IN. Empty = auto-detect.
GEMINI_STT_LANGUAGE_CODES=
# VERBATIM or SMART (dedicated transcribe models only).
GEMINI_STT_MODE=VERBATIM
GEMINI_TIMEOUT_SECONDS=30

# --- Spotify (optional; requires Spotify Premium for playback control) -------
# Create an app at https://developer.spotify.com/dashboard (Web API).
# The redirect URI must match the dashboard exactly; use 127.0.0.1, not localhost.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/v1/spotify/callback
SPOTIFY_SCOPES=user-read-playback-state user-modify-playback-state
# Refresh token is stored here (chmod 600). Keep it out of git.
SPOTIFY_TOKEN_FILE=.spotify_token.json
SPOTIFY_TIMEOUT_SECONDS=15
# Spotify Connect name of the ADI speaker (firmware adi_spotify). Requests spoken to the ADI
# device with no device named play there. Empty = use the active Spotify device.
SPOTIFY_DEFAULT_DEVICE=

# --- Tools -------------------------------------------------------------------
TOOLS_TIMEOUT_SECONDS=10
# open_meteo (free, no key) or none
WEATHER_PROVIDER=open_meteo
# Used when the user doesn't name a city, e.g. "Bloomington, Indiana". Empty = ask.
WEATHER_DEFAULT_LOCATION=
WEATHER_UNITS=metric
# none | gemini (Grounding with Google Search, uses GEMINI_API_KEY) | brave
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_GEMINI_MODEL=gemini-2.5-flash
BRAVE_SEARCH_API_KEY=

# --- Computer control (off by default; allowlisted targets only, macOS) ------
# Only works when the backend runs directly on your Mac (not in Docker).
COMPUTER_CONTROL_ENABLED=false
# spoken name=macOS app name; semicolon-separated
COMPUTER_CONTROL_APPS=spotify=Spotify;chrome=Google Chrome;safari=Safari;terminal=Terminal;vs code=Visual Studio Code;finder=Finder
COMPUTER_CONTROL_WEBSITES=youtube=https://www.youtube.com;gmail=https://mail.google.com;github=https://github.com
# spoken name=path, e.g. adi=~/code/assistant-backend
COMPUTER_CONTROL_PROJECTS=
COMPUTER_CONTROL_PROJECT_APP=Visual Studio Code

# --- ESP32 / device WebSocket (/api/v1/device/ws) ----------------------------
DEVICE_WS_ENABLED=true
# Per-device credentials "device_id:token,device_id:token" (recommended).
DEVICE_TOKENS=
# Or one token for all devices. If both empty, API_KEY is used; if that is empty
# too, device auth is disabled (development only; refused when APP_ENV=production).
DEVICE_SHARED_TOKEN=
DEVICE_HELLO_TIMEOUT_SECONDS=10
DEVICE_HEARTBEAT_SECONDS=20
DEVICE_TIMEOUT_SECONDS=60
# Default microphone format when audio_start doesn't declare one.
DEVICE_AUDIO_INPUT_FORMAT=pcm_s16le
DEVICE_AUDIO_INPUT_SAMPLE_RATE=16000
DEVICE_AUDIO_INPUT_CHANNELS=1
# Speaker output: wav or pcm_s16le. Sample rate 0 = TTS native (24 kHz for Gemini).
DEVICE_AUDIO_OUTPUT_FORMAT=wav
DEVICE_AUDIO_OUTPUT_SAMPLE_RATE=0
DEVICE_AUDIO_CHUNK_BYTES=4096
DEVICE_MAX_AUDIO_SECONDS=30
# Remove DC offset and boost quiet mic audio before STT.
DEVICE_AUDIO_NORMALIZE=true
# Debug: save every recording here as a WAV so you can listen to it (empty = off).
DEVICE_DEBUG_AUDIO_DIR=

# ---------------------------------------------------------------------------
# Other providers already supported by this backend. Keys stay empty here; put real
# values only in .env. (Added so .env.example lists every setting.)
# ---------------------------------------------------------------------------
# --- Groq (STT_PROVIDER=groq) ---
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_LANGUAGE=
GROQ_STT_PROMPT=
GROQ_TIMEOUT_SECONDS=60.0
# --- OpenRouter (LLM_PROVIDER=openrouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_MODEL=openrouter/free
OPENROUTER_LLM_MAX_OUTPUT_TOKENS=512
OPENROUTER_LLM_TEMPERATURE=0.4
OPENROUTER_TIMEOUT_SECONDS=60.0
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=Adi Voice Assistant
# --- ElevenLabs (TTS_PROVIDER=elevenlabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_LANGUAGE_CODE=
ELEVENLABS_TTS_OUTPUT_FORMAT=pcm_16000
ELEVENLABS_TIMEOUT_SECONDS=60.0
